# ============================================================
#  CELURA API · Variables de entorno
#  Copiar a .env y completar. NUNCA commitear .env al repo.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- JWT (debe coincidir con el JWT secret de Supabase) ---
JWT_SECRET=super-secret-jwt-key-from-supabase-dashboard

# --- Encriptación de API keys de los doctores ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64-hex-chars-here

# --- Redis (Upstash - URL con autenticación incluida) ---
REDIS_URL=rediss://default:password@region.upstash.io:6379

# --- Servidor ---
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# --- CORS ---
# En producción: https://tudominio.com (cPanel)
ALLOWED_ORIGINS=http://localhost:5173,https://app.celura.clinic

# --- Sesiones de WhatsApp ---
# En Render: usar el mount path del Persistent Disk
WA_SESSIONS_PATH=./sessions

# --- Logs ---
LOG_LEVEL=info

# --- Emails (Resend) ---
# Obtener en https://resend.com/api-keys
# Si se omite, los emails se loguean en email_log con status=skipped (modo dry-run).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Celura <hola@celura.clinic>
RESEND_REPLY_TO=hola@celura.clinic
SUPPORT_EMAIL=hola@celura.clinic

# --- Branding ---
BRAND_NAME=Celura
DASHBOARD_URL=https://app.celura.app
