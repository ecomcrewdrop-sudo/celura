# SPA fallback: cualquier ruta no existente sirve index.html
# para que React Router maneje el routing del lado del cliente.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No reescribir si el archivo o carpeta existe
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás → index.html
  RewriteRule . /index.html [L]
</IfModule>

# Cache largo para assets con hash en el nombre
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# Forzar HTTPS (opcional — actívalo si tu dominio ya tiene SSL en cPanel)
